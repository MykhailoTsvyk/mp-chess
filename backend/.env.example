# copy to .env and fill in; never commit .env

# the frontend's address: CORS origin and the base of email activation links
# development: http://localhost:5173   production: https://<your-service>.onrender.com
CLIENT_URL=

# production only: "production" turns on serving the built frontend and secure cookies
NODE_ENV=

# database, production: one connection string (Neon); leave empty locally
DATABASE_URL=

# database, local development
DB_USER=
DB_PASS=
DB_HOST=
DB_PORT=
DB_NAME=
# optional, defaults to chessMP_test; must end with _test
TEST_DB_NAME=

# bcrypt cost, defaults to 12
SALT_ROUNDS=

# long random strings, different from each other and per environment
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# email, production: Brevo HTTP API (Render's free plan blocks SMTP)
BREVO_API_KEY=
# a sender address verified in Brevo
EMAIL_FROM=

# email, local development: Gmail app password for noreply.chess.mp@gmail.com
GOOGLE_APP_PASS=
